      },
      "conditions": [
        {
          "id": "C1",
          "text": "责任在数据管理命令与界面语义。应把“重置当前设备”和“清空主存储”分开。完成条件是前者不改变后端数据，后者明确展示真实影响范围。",
          "evidence_scope": "device-reset-scope",
          "required_evidence_kinds": [
            "automated-test"
          ]
        }
      ]
    },
    {

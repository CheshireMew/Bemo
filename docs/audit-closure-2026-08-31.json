  "original_findings": [
    {
      "id": "BEMO-AUD-001",
      "title": "P1：Web/Desktop 同步拉取没有写回主存储。",
      "source": {
        "reference": "本任务原始只读审查报告；main@83ab007974982b274d92a3b34f56f27a08a7f55c（2026-08-31）",
        "content_identity": "sha256:500cb04d558784370447fa7a73487203d2de32bdae5e218098663b01b7bc796f"
      },
      "conditions": [
        {
          "id": "C1",
          "text": "责任在同步流程与运行时存储适配边界。修复应让初始化、远端应用、冲突解决和补发都使用当前主存储，并处理“主存储写入成功、浏览器同步队列写入失败”的恢复。完成时应证明远端新增、修改和删除在刷新后仍然存在于正确的主存储中。",
          "evidence_scope": "backend-primary-sync",
          "required_evidence_kinds": [
            "automated-test"
          ]
        }
      ]
    },
    {
      "id": "BEMO-AUD-002",
      "title": "P1：Flomo 导入的后端记录与同步记录不是同一个 ID。",
      "source": {
        "reference": "本任务原始只读审查报告；main@83ab007974982b274d92a3b34f56f27a08a7f55c（2026-08-31）",
        "content_identity": "sha256:500cb04d558784370447fa7a73487203d2de32bdae5e218098663b01b7bc796f"
      },
      "conditions": [
        {
          "id": "C1",
          "text": "责任在导入适配层。应统一导入后的正式记录身份，并以实际保存结果生成同步事件。完成条件是导入、同步、刷新、再次编辑后，仍只有一条具有相同 ID 的笔记。",
          "evidence_scope": "canonical-import-identity",
          "required_evidence_kinds": [
            "automated-test"
          ]
        }
      ]
    },
    {
      "id": "BEMO-AUD-003",
      "title": "P1：清空回收站的路由被覆盖，且批量删除没有同步记录。",
      "source": {
        "reference": "本任务原始只读审查报告；main@83ab007974982b274d92a3b34f56f27a08a7f55c（2026-08-31）",
        "content_identity": "sha256:500cb04d558784370447fa7a73487203d2de32bdae5e218098663b01b7bc796f"
      },
      "conditions": [
        {
          "id": "C1",
          "text": "责任覆盖回收站 API 与同步事件生成。完成条件是正式清空入口成功删除准确集合，并让远端收到对应永久删除记录，其他设备不会重新保留这些笔记。",
          "evidence_scope": "trash-purge-sync",
          "required_evidence_kinds": [
            "automated-test"
          ]
        }
      ]
    },
    {
      "id": "BEMO-AUD-004",
      "title": "P1：备份恢复先覆盖数据，失败后没有回滚。",
      "source": {
        "reference": "本任务原始只读审查报告；main@83ab007974982b274d92a3b34f56f27a08a7f55c（2026-08-31）",
        "content_identity": "sha256:500cb04d558784370447fa7a73487203d2de32bdae5e218098663b01b7bc796f"
      },
      "conditions": [
        {
          "id": "C1",
          "text": "责任在各运行时的恢复实现。应先完整验证，再进行可恢复的替换。完成条件是无效备份、附件失败或中断均不会留下“旧数据已消失、新数据只恢复一半”的状态。Markdown 归档也使用这条恢复路径，需要一起处理。",
          "evidence_scope": "atomic-backup-restore",
          "required_evidence_kinds": [
            "automated-test"
          ]
        }
      ]
    },
    {
      "id": "BEMO-AUD-005",
      "title": "P1：“恢复首次安装状态”实际会清空后端主存储。",
      "source": {
        "reference": "本任务原始只读审查报告；main@83ab007974982b274d92a3b34f56f27a08a7f55c（2026-08-31）",
